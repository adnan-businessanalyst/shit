{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/ofoq-al-diafah run build",
  "outputDirectory": "artifacts/ofoq-al-diafah/dist",
  "framework": null,
  "build": {
    "env": {
      "PORT": "5000",
      "BASE_PATH": "/",
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
